# Copy this file to `.env` and fill in your values.
# NEVER commit your real .env file (it is already in .gitignore).

# --- API keys (both free; see README for how to get them) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Transcription ---
# Whisper model on Groq (used only when YouTube has no captions, or for uploaded files)
GROQ_WHISPER_MODEL=whisper-large-v3
# Local fallback model: tiny | base | small | medium  (small is a good speed/quality balance on CPU)
LOCAL_WHISPER_MODEL=small
# int8 is the fastest on CPU. Use float16 if you have an NVIDIA GPU and set LOCAL_WHISPER_DEVICE=cuda
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_DEVICE=cpu
# Length of each audio piece sent to Whisper, in seconds (keeps every upload under Groq's size limit)
AUDIO_SEGMENT_SECONDS=600

# --- LLM (text generation) ---
# Which provider to use: groq | gemini
LLM_PROVIDER=groq
# Groq chat model. Check what your account offers at https://console.groq.com/docs/models
#   openai/gpt-oss-120b  -> best quality (default)
#   openai/gpt-oss-20b   -> faster, slightly weaker
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss models "think" before answering: low | medium | high (low = faster, fewer tokens)
GROQ_REASONING_EFFORT=low
# Gemini model. "gemini-flash-latest" always points to Google's current Flash model.
# Pin an exact version (e.g. gemini-3.5-flash) for reproducible evaluation results.
GEMINI_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.3
# How many LLM calls to run at the same time. Keep 1 on free tiers to avoid rate limits.
LLM_MAX_CONCURRENCY=1

# --- Notes ---
# Length of each transcript chunk in seconds (map step)
CHUNK_SECONDS=300
# Language the notes are written in: english | hindi | hinglish
NOTES_LANGUAGE=english

# --- Limits ---
# Videos longer than this (in hours) get a warning
LONG_VIDEO_WARNING_HOURS=3
# Largest file that can be uploaded, in MB
MAX_UPLOAD_MB=500

# --- Web server ---
# How many lectures are processed at the same time (keep 1 on free API tiers)
MAX_PARALLEL_JOBS=1
# Websites allowed to call the API (JSON list). Add your Vercel URL when deploying.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- General ---
DATA_DIR=data
LOG_LEVEL=INFO
